# Tokenul botului, din Discord Developer Portal -> aplicația ta -> Bot -> Reset Token.
# Nu-l publica niciodată (nu face commit la fișierul .env).
DISCORD_TOKEN=

# Opțional: ID-ul serverului tău. Dacă e completat, comenzile apar instant pe acel server.
# Lasă gol ca să sincronizezi comenzile global (pe toate serverele unde e botul).
GUILD_ID=
